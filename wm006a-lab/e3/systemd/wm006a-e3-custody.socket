[Unit]
Description=006A E3 lab approval fixture: custody approval socket
ConditionVirtualization=vm

[Socket]
ListenStream=/run/wm006a-e3/custody/sock
Accept=no
Service=wm006a-e3-signer.service
FileDescriptorName=custody
SocketUser=root
SocketGroup=wm006a-custody
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Backlog=16
