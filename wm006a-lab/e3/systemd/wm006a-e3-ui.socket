[Unit]
Description=006A E3 lab approval fixture: operator proposal socket
ConditionVirtualization=vm

[Socket]
ListenStream=/run/wm006a-e3/ui/sock
Accept=no
Service=wm006a-e3-signer.service
FileDescriptorName=ui
SocketUser=root
SocketGroup=wm006a-ui
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Backlog=16
