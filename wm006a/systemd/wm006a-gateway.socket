[Unit]
Description=006A disposable VM gateway socket
ConditionVirtualization=vm

[Socket]
ListenStream=/run/wm006a/gateway/sock
Accept=no
Service=wm006a-gateway.service
FileDescriptorName=gateway
SocketUser=root
SocketGroup=wm006a-gateway
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Backlog=16
