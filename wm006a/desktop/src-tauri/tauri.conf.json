{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallet Manager 006A",
  "version": "0.1.0",
  "identifier": "org.sinteza.WalletManagerLab",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "Wallet Manager 006A", "width": 800, "height": 640, "dragDropEnabled": false}],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {"active": false, "icon": ["icons/icon.png"]}
}
